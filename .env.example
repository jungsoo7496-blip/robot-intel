# ── Supabase ──────────────────────────────────────────────
# 브라우저 노출 가능 (anon 키는 RLS로 보호됨)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버·배치 전용 — 절대 브라우저/커밋 금지
SUPABASE_SERVICE_ROLE_KEY=
# Python 배치·백업용 직접 연결 (Supabase 대시보드 > Database > Connection string)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=

# ── 네이버 뉴스 검색 — NAVER API HUB (ncloud.com) ─────────
# 헤더: X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 모델 라우팅 (설계 §7)
ARTICLE_MODEL=gemini-flash-lite-latest
BRIEF_MODEL=gemini-flash-latest
BRIEF_FALLBACK_MODEL=gemini-flash-lite-latest

# ── 인증 ──────────────────────────────────────────────────
# 쉼표 구분. 예: example.org
ALLOWED_EMAIL_DOMAINS=example.org

# ── 배치 처리 한도 (설계 §3.3, §7, §9.5) ──────────────────
ARTICLE_REQUEST_INTERVAL_SECONDS=5
ARTICLE_BATCH_MAX_COUNT=40
ARTICLE_BATCH_MAX_SECONDS=270
ARTICLE_DAILY_SOFT_LIMIT=330
BRIEF_DAILY_RESERVE=5

# ── 콘텐츠 처리 ───────────────────────────────────────────
RAW_TEXT_RETENTION_DAYS=30
CLEAN_TEXT_MAX_LENGTH=12000
TITLE_SIMILARITY_THRESHOLD=85

# ── 백업 ──────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=28

# ── 비상 잠금 스위치 (D-003, 평상시 비움) ─────────────────
# 값을 설정하면 ?access=토큰 링크로만 접속 가능해진다.
# 스크래핑 남용 등 문제 발생 시에만 사용.
SITE_ACCESS_TOKEN=

# ── 브리프 ────────────────────────────────────────────────
# 격주 발행: cron은 .github/workflows/generate-brief.yml 에서 관리
BRIEF_PUBLISH_DAY=MON
BRIEF_PUBLISH_HOUR_KST=9
